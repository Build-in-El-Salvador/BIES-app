# ─────────────────────────────────────────────────────────────────────────────
# BIES Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Comma-separated list of allowed CORS origins
CORS_ORIGIN="http://localhost:5173"

# ─── Database ─────────────────────────────────────────────────────────────────
# Dev: SQLite (fast local setup)
DATABASE_URL="file:./prisma/dev.db"

# Production: PostgreSQL (required for 500+ concurrent users)
# DATABASE_URL="postgresql://user:password@localhost:5432/bies?schema=public&connection_limit=20&pool_timeout=20"

# Emergency escape hatch for the Docker boot migration flow: set to "push" to
# restore the legacy `prisma db push` behavior (no migration tracking).
# See docs/deployment.md → Migrations. Leave unset normally.
# DB_BOOT_MODE="push"

# ─── Authentication ───────────────────────────────────────────────────────────
# REQUIRED: Generate with: openssl rand -base64 64
JWT_SECRET="your-super-secret-jwt-key-change-this-now"
JWT_EXPIRES_IN="7d"

# Proxies in front of this server, so rate limits see each visitor's real IP.
# Production (YunoHost nginx -> container nginx -> server) needs 2. Default: 1.
TRUST_PROXY=2

# REQUIRED: Exactly 32 characters for AES-256-GCM key derivation
ENCRYPTION_SECRET="your-32-char-encryption-secret!!"

# ─── Redis (optional, but recommended for production) ─────────────────────────
# Enables distributed caching and rate limiting across multiple server instances.
# Falls back to in-memory cache if not set (single-instance only).
REDIS_URL="redis://localhost:6379"
# Cloud options: redis://user:password@hostname:port
# Upstash example: rediss://default:password@endpoint.upstash.io:6379

# ─── S3 Compatible Storage (AWS S3, Cloudflare R2, DigitalOcean Spaces) ──────
# Leave blank to use local file storage (uploads/ directory)
S3_ENDPOINT="https://your-account.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"
S3_BUCKET="bies-uploads"
# Public CDN URL for publicly accessible files (avatars, thumbnails)
S3_PUBLIC_URL="https://pub-xxxxx.r2.dev"

# ─── Admin ────────────────────────────────────────────────────────────────────
# Comma-separated hex pubkeys that are auto-promoted to ADMIN on Nostr login
ADMIN_PUBKEYS=""

# ─── Nostr Relays ─────────────────────────────────────────────────────────────
NOSTR_RELAYS="wss://relay.damus.io,wss://relay.primal.net,wss://nos.lol"

# ─── BIES Issuer Identity (NIP-58 badges) ─────────────────────────────────────
# Private key (hex or nsec) the platform uses to sign NIP-58 badge
# definitions (kind 30009) and awards (kind 8). Leave blank to disable
# Nostr badge publishing — in-app badges keep working; unpublished awards
# are retried automatically once the key is set.
# Generate once with: openssl rand -hex 32
BIES_ISSUER_PRIVKEY=""

# ─── Gamification ─────────────────────────────────────────────────────────────
# Genesis badge cutoff — ISO date or datetime (e.g. "2026-08-01" or
# "2026-08-01T00:00:00Z"). Members whose account was created on or before
# this moment earn the legendary "Genesis" badge. Leave unset to keep the
# badge dormant (it is never awarded while this is blank or unparseable).
GENESIS_CUTOFF=""

# ─── Public App Origin ────────────────────────────────────────────────────────
# Absolute origin where the frontend is served — used for badge artwork URLs
# embedded in Nostr events (<APP_PUBLIC_URL>/badges/<badgeId>.png).
# Defaults to https://app.buildinelsalvador.com when unset.
APP_PUBLIC_URL="https://app.buildinelsalvador.com"

# ─── Email (optional — for notification emails) ───────────────────────────────
# Leave blank to disable email notifications
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="your-sendgrid-api-key"
SMTP_FROM="noreply@bies.io"

# ─── Native Push (APNs) — optional, for iOS native push notifications ─────────
# Leave APNS_KEY_ID / APNS_TEAM_ID / APNS_AUTH_KEY blank to disable native push
# entirely (the server boots and web push is unaffected).
#
# Create an APNs Auth Key (.p8) at Apple Developer > Certificates, Identifiers &
# Profiles > Keys, with "Apple Push Notifications service (APNs)" enabled. Note
# the Key ID; your Team ID is shown top-right of the developer portal.
APNS_KEY_ID=""
APNS_TEAM_ID=""
# Must match capacitor.config.ts appId and the Xcode bundle identifier.
APNS_BUNDLE_ID="com.bies.app"
# Paste the full .p8 PEM. If your secret store is single-line, escape the
# newlines as literal \n — the server un-escapes them at load time:
#   APNS_AUTH_KEY="-----BEGIN PRIVATE KEY-----\nMIG....\n-----END PRIVATE KEY-----\n"
APNS_AUTH_KEY=""
# true for TestFlight / App Store builds (api.push.apple.com); false for Xcode
# debug builds (api.sandbox.push.apple.com). A mismatch returns BadDeviceToken.
APNS_PRODUCTION="false"
