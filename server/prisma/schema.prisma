// BIES Platform – Prisma Schema
// Production DB: PostgreSQL (change provider to "postgresql" for prod)
// Dev DB: SQLite (provider = "sqlite")

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// User & Auth
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id               String   @id @default(cuid())
  email            String?  @unique
  passwordHash     String?  @map("password_hash")
  nostrPubkey      String   @unique @map("nostr_pubkey")
  encryptedPrivkey String?  @map("encrypted_privkey")
  role             String   @default("MEMBER") // BUILDER | INVESTOR | MOD | MEMBER | EDUCATOR | EVENT_HOST
  isAdmin          Boolean  @default(false) @map("is_admin")
  isVerified       Boolean  @default(false) @map("is_verified")
  isBanned         Boolean  @default(false) @map("is_banned")
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  profile          Profile?
  projects         Project[]
  sessions         Session[]
  sentMessages     Message[]         @relation("SentMessages")
  receivedMessages Message[]         @relation("ReceivedMessages")
  watchlist        WatchlistItem[]
  investments      Investment[]
  notifications    Notification[]
  pushSubscriptions PushSubscription[]
  deviceTokens     DeviceToken[]
  following        Follow[]          @relation("Following")
  followers        Follow[]          @relation("Followers")
  hostedEvents     Event[]
  auditLogs        AuditLog[]
  projectViews     ProjectView[]
  teamMemberships  ProjectTeamMember[]
  deckRequests     DeckRequest[]
  investorRequests InvestorRequest[]
  eventRSVPs      EventAttendee[]
  eventTickets     Ticket[]
  settings         UserSettings?
  fingerprints     BrowserFingerprint[]
  feedback         Feedback[]
  coworkVenues      CoworkVenue[]
  coworkSessions    CoworkSession[]
  coworkAttendances CoworkAttendee[]
  pointEvents      PointEvent[]
  score            UserScore?
  badges           UserBadge[]
  leaderboardSnapshots LeaderboardSnapshot[]
  directoryListings     DirectoryListing[]     @relation("DirectoryListingsOwned")
  directoryMemberships  DirectoryListing[]     @relation("DirectoryListingsAsMember")
  directoryEndorsements DirectoryEndorsement[]
  courses               Course[]
  enrollments           Enrollment[]
  coursePurchases       CoursePurchase[]
  vouchersCreated       Voucher[]
  voucherRedemptions    VoucherRedemption[]
  bountiesPosted        Bounty[]               @relation("BountiesPosted")
  bountySubmissions     BountySubmission[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// One-time 6-digit codes sent by email (sign-in today; confirming account
// deletion and key export later). Nothing here is usable if leaked: the code
// is stored as an HMAC, and the address and IP only as HMACs, so the table
// never holds the plain address of someone who mistyped theirs. Rows are
// deleted after 24 hours (services/emailCode.service.ts).
model EmailCode {
  id         String    @id @default(cuid())
  emailHash  String    @map("email_hash")
  purpose    String    @default("login") // login | delete_account | export_key
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  ipHash     String?   @map("ip_hash")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([emailHash, purpose, createdAt])
  @@index([ipHash, createdAt])
  @@index([createdAt])
  @@map("email_codes")
}

// ─────────────────────────────────────────────────────────────────────────────
// Profile
// ─────────────────────────────────────────────────────────────────────────────

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  name         String   @default("")
  bio          String   @default("")
  avatar       String   @default("")
  banner       String   @default("")
  location     String   @default("")
  skills       String   @default("[]")  // JSON array
  website      String   @default("")
  twitter      String   @default("")
  linkedin     String   @default("")
  github       String   @default("")
  company      String   @default("")
  title        String   @default("")
  tags         String   @default("[]")  // JSON array
  // Investor-specific
  investmentFocus String @default("[]") @map("investment_focus") // JSON array of sectors
  investmentStage String @default("[]") @map("investment_stage") // JSON array of stages
  minTicket    Float?   @map("min_ticket")
  maxTicket    Float?   @map("max_ticket")
  portfolioCount Int    @default(0) @map("portfolio_count")
  // Builder-specific
  lookingFor   String   @default("[]") @map("looking_for") // JSON array (funding, cofounder, etc.)
  // Profile sections
  experience     String   @default("[]")  // JSON array of {title,company,date,description}
  biesProjects   String   @default("[]") @map("bies_projects")  // JSON array of {id,name,role,status,image}
  customSections String   @default("[]") @map("custom_sections") // JSON array of {title,type,placement,body,...}
  showExperience Boolean  @default(true) @map("show_experience")
  nostrFeedMode  String   @default("combined") @map("nostr_feed_mode")
  nostrNpub      String   @default("") @map("nostr_npub")
  // NIP-05 & Lightning
  nip05Name        String?  @unique @map("nip05_name")
  lightningAddress String   @default("") @map("lightning_address")
  bolt12Offer      String   @default("") @map("bolt12_offer")
  // Coinos custodial wallet
  coinosUsername   String?  @unique @map("coinos_username")
  coinosToken      String?  @map("coinos_token") // Encrypted JWT for Coinos API
  // Blink (Galoy) wallet — connected with a user-supplied API key
  blinkUsername    String?  @map("blink_username")
  blinkWalletId    String?  @map("blink_wallet_id")
  blinkApiKey      String?  @map("blink_api_key") // Encrypted API key for the Blink GraphQL API
  // Misc
  isPublic     Boolean  @default(true) @map("is_public")
  viewCount    Int      @default(0) @map("view_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ─────────────────────────────────────────────────────────────────────────────
// Project
// ─────────────────────────────────────────────────────────────────────────────

model Project {
  id           String   @id @default(cuid())
  title        String
  description  String
  category     String   @default("OTHER")
  // ENERGY | FINTECH | EDUCATION | AGRICULTURE | REAL_ESTATE | INFRASTRUCTURE | TOURISM | TECHNOLOGY | OTHER
  stage        String   @default("IDEA")
  // IDEA | MVP | GROWTH | SCALING
  fundingGoal  Float?   @map("funding_goal")
  raisedAmount Float    @default(0) @map("raised_amount")
  thumbnail    String   @default("")
  deckKey      String?  @map("deck_key")
  requiresDeckApproval Boolean  @default(true) @map("requires_deck_approval")
  demoUrl      String   @default("") @map("demo_url")
  websiteUrl   String   @default("") @map("website_url")
  tags         String   @default("[]") // JSON array
  customSections String  @default("[]") @map("custom_sections") // JSON array of { title, body }
  teamInfo     String   @default("[]") @map("team_info") // JSON array of { name, position, avatar }
  useOfFunds   String   @default("[]") @map("use_of_funds") // JSON array of { label, percentage }
  ownerRole    String?  @map("owner_role")
  status       String   @default("draft") // draft | pending-review | active
  isPublished  Boolean  @default(true) @map("is_published")
  isFeatured   Boolean  @default(false) @map("is_featured")
  viewCount    Int      @default(0) @map("view_count")
  nostrEventId        String?  @map("nostr_event_id")
  nostrListingEventId String?  @map("nostr_listing_event_id")
  ownerId      String   @map("owner_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  owner        User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  watchlisted  WatchlistItem[]
  investments  Investment[]
  teamMembers  ProjectTeamMember[]
  views        ProjectView[]
  updates      ProjectUpdate[]
  deckRequests DeckRequest[]
  zapReceipts  ZapReceipt[]

  @@map("projects")
}

model ProjectTeamMember {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      String   @default("MEMBER") // FOUNDER | COFOUNDER | ADVISOR | MEMBER
  title     String   @default("")
  addedAt   DateTime @default(now()) @map("added_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_team_members")
}

model ProjectUpdate {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  title     String
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_updates")
}

model ProjectView {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  userId    String?  @map("user_id")
  ipAddress String?  @map("ip_address")
  viewedAt  DateTime @default(now()) @map("viewed_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("project_views")
}

// ─────────────────────────────────────────────────────────────────────────────
// Investments / Funding
// ─────────────────────────────────────────────────────────────────────────────

model Investment {
  id         String   @id @default(cuid())
  projectId  String   @map("project_id")
  investorId String   @map("investor_id")
  amount     Float
  currency   String   @default("USD") // USD | BTC | SATS
  status     String   @default("PENDING")
  // PENDING | COMMITTED | COMPLETED | WITHDRAWN
  terms      String   @default("") // free-form deal terms
  notes      String   @default("")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  investor User    @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@unique([projectId, investorId])
  @@map("investments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Watchlist (Investor saved projects)
// ─────────────────────────────────────────────────────────────────────────────

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  projectId String   @map("project_id")
  note      String   @default("")
  addedAt   DateTime @default(now()) @map("added_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@map("watchlist_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// Messaging
// ─────────────────────────────────────────────────────────────────────────────

model Message {
  id          String   @id @default(cuid())
  senderId    String   @map("sender_id")
  recipientId String   @map("recipient_id")
  content     String   // Encrypted (NIP-04) or plaintext
  isEncrypted Boolean  @default(true) @map("is_encrypted")
  nostrEventId String? @map("nostr_event_id") // Reference to Nostr DM event
  isRead      Boolean  @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime @default(now()) @map("created_at")

  sender    User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId])
  @@index([recipientId, isRead])
  @@map("messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String
  // NEW_MESSAGE | PROJECT_VIEW | INVESTMENT_INTEREST | WATCHLIST_ADD
  // FOLLOW | PROJECT_UPDATE | SYSTEM
  title     String
  body      String
  data      String   @default("{}") // JSON metadata
  isRead    Boolean  @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// Push Subscriptions (Web Push API)
// ─────────────────────────────────────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
  @@map("push_subscriptions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Device Tokens (Native Push — APNs on iOS)
// ─────────────────────────────────────────────────────────────────────────────

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  platform  String   @default("ios")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Events
// ─────────────────────────────────────────────────────────────────────────────

model Event {
  id          String   @id @default(cuid())
  hostId      String   @map("host_id")
  title       String
  description String
  category    String   @default("NETWORKING")
  // NETWORKING | CONFERENCE | WORKSHOP | HACKATHON | MEETUP | DEMO_DAY | OTHER
  visibility  String   @default("PUBLIC") // PUBLIC | LIMITED_SPACES | INVITE_ONLY | PRIVATE | DRAFT
  location    String   @default("")
  isOnline    Boolean  @default(false) @map("is_online")
  onlineUrl   String   @default("") @map("online_url")
  startDate   DateTime @map("start_date")
  endDate     DateTime? @map("end_date")
  thumbnail   String   @default("")
  ticketUrl   String   @default("") @map("ticket_url")
  maxAttendees Int?    @map("max_attendees")
  priceSats   Int?     @map("price_sats") // null/0 = free (RSVP-only)
  ticketCapacity Int?  @map("ticket_capacity")
  payoutLightningAddress String @default("") @map("payout_lightning_address") // per-event override; falls back to host Profile.lightningAddress
  isPublished Boolean  @default(true) @map("is_published")
  isFeatured  Boolean  @default(false) @map("is_featured")
  isOfficial  Boolean  @default(false) @map("is_official")
  isEndorsed  Boolean  @default(false) @map("is_endorsed")
  endorsementRequested Boolean @default(false) @map("endorsement_requested")
  guestList       String   @default("[]") @map("guest_list") // JSON array of {name, userId?}
  tags            String   @default("[]") // JSON array
  locationName    String   @default("") @map("location_name")
  locationAddress String   @default("") @map("location_address")
  locationMapUrl  String   @default("") @map("location_map_url")
  customSections  String   @default("[]") @map("custom_sections") // JSON array of {title, content}
  nostrEventId    String   @default("") @map("nostr_event_id") // NIP-52 calendar event id
  nostrPublish    String   @default("none") @map("nostr_publish") // none | bies | public | both
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  host      User              @relation(fields: [hostId], references: [id], onDelete: Cascade)
  attendees EventAttendee[]
  tickets   Ticket[]

  @@map("events")
}

model Ticket {
  id          String   @id @default(cuid())
  eventId     String   @map("event_id")
  buyerId     String   @map("buyer_id")
  amountSats  Int      @map("amount_sats")
  bolt11      String
  paymentHash String   @unique @map("payment_hash")
  preimage    String   @default("")
  verifyUrl   String   @default("") @map("verify_url") // LUD-21 verify URL from the LNURL callback
  status      String   @default("PENDING") // PENDING | PAID | EXPIRED | CANCELLED
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  paidAt      DateTime? @map("paid_at")
  checkedInAt DateTime? @map("checked_in_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  buyer User  @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([buyerId])
  @@map("tickets")
}

model EventAttendee {
  id            String   @id @default(cuid())
  eventId       String   @map("event_id")
  userId        String   @map("user_id")
  status        String   @default("GOING") // GOING | INTERESTED | NOT_GOING
  nostrEventId  String?  @map("nostr_event_id") // NIP-52 RSVP event id (kind 31925)
  joinedAt      DateTime @default(now()) @map("joined_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_attendees")
}

// ─────────────────────────────────────────────────────────────────────────────
// Cowork: server-backed, joinable cowork sessions with venues + attendance
// ─────────────────────────────────────────────────────────────────────────────

model CoworkVenue {
  id          String   @id @default(cuid())
  name        String
  address     String   @default("")
  area        String   @default("")   // neighborhood/city — groups the dropdown
  lat         Float?
  lng         Float?
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy   User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  sessions    CoworkSession[]

  @@unique([name, area])   // DB backstop for add-with-dedupe
  @@index([area])
  @@map("cowork_venues")
}

model CoworkSession {
  id           String    @id @default(cuid())
  title        String
  hostId       String    @map("host_id")
  venueId      String?   @map("venue_id")
  locationName String    @default("") @map("location_name")
  lat          Float?
  lng          Float?
  note         String    @default("")
  amenities    String    @default("[]")   // JSON array e.g. ["coffee","food","wifi_fast","seats:6"]
  startTime    DateTime  @map("start_time")
  endTime      DateTime? @map("end_time")
  status       String    @default("ACTIVE") // ACTIVE | ENDED
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  host         User             @relation(fields: [hostId], references: [id], onDelete: Cascade)
  venue        CoworkVenue?     @relation(fields: [venueId], references: [id], onDelete: SetNull)
  attendees    CoworkAttendee[]

  @@index([status])
  @@index([hostId])
  @@index([venueId])
  @@map("cowork_sessions")
}

model CoworkAttendee {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  userId    String   @map("user_id")
  joinedAt  DateTime @default(now()) @map("joined_at")

  session   CoworkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
  @@map("cowork_attendees")
}

// ─────────────────────────────────────────────────────────────────────────────
// Social: Following
// ─────────────────────────────────────────────────────────────────────────────

model Follow {
  id          String   @id @default(cuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit Log
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String   // e.g. AUTH_LOGIN, PROJECT_CREATE, PROFILE_UPDATE
  resource  String   @default("") // e.g. "project:abc123"
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  metadata  String   @default("{}") // JSON
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Deck Access Requests
// ─────────────────────────────────────────────────────────────────────────────

model DeckRequest {
  id         String    @id @default(cuid())
  projectId  String    @map("project_id")
  investorId String    @map("investor_id")
  status     String    @default("PENDING") // PENDING | APPROVED | DENIED
  message    String    @default("") // investor can include a note
  reviewedAt DateTime? @map("reviewed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  investor User    @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@unique([projectId, investorId])
  @@map("deck_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
// Contact Submissions
// ─────────────────────────────────────────────────────────────────────────────

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  role      String   @default("") // BUILDER | INVESTOR | MEDIA | OTHER
  message   String
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_submissions")
}

// ─────────────────────────────────────────────────────────────────────────────
// User Feedback
// ─────────────────────────────────────────────────────────────────────────────

model Feedback {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  type       String    @default("GENERAL") // BUG | FEATURE | LOVE | GENERAL
  message    String
  status     String    @default("NEW") // NEW | IN_REVIEW | FIXED | WONT_FIX | PLANNED | DUPLICATE | CLOSED
  priority   String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  adminNote  String    @default("") @map("admin_note")
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([type])
  @@map("feedback")
}

// ─────────────────────────────────────────────────────────────────────────────
// User Settings
// ─────────────────────────────────────────────────────────────────────────────

model UserSettings {
  id                   String  @id @default(cuid())
  userId               String  @unique @map("user_id")
  emailNotifications   Boolean @default(true) @map("email_notifications")
  pushNotifications    Boolean @default(true) @map("push_notifications")
  marketingEmails      Boolean @default(false) @map("marketing_emails")
  notifyMessages       Boolean @default(true) @map("notify_messages")
  notifyInvestments    Boolean @default(true) @map("notify_investments")
  notifyFollows        Boolean @default(true) @map("notify_follows")
  notifyProjectUpdates Boolean @default(true) @map("notify_project_updates")
  relays               String  @default("[]") // JSON array of relay URLs
  mediaReadItems       String  @default("{}") @map("media_read_items") // JSON: { watched: [...], read: [...] }
  preferences          String  @default("{}") // JSON: { theme, language, projectsView, membersView, eventsView, mediaView }
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Site Settings (singleton row for platform-wide config)
// ─────────────────────────────────────────────────────────────────────────────

model SiteSettings {
  id               String   @id @default("default")
  nostrNpubs       String   @default("[]") @map("nostr_npubs")
  twitterHandles   String   @default("[]") @map("twitter_handles")
  livestreamUrl    String   @default("") @map("livestream_url")
  livestreamActive Boolean  @default(false) @map("livestream_active")
  featureFlags     String   @default("{}") @map("feature_flags") // JSON: { [featureSlug]: boolean } — missing slugs default enabled
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Content: Articles
// ─────────────────────────────────────────────────────────────────────────────

model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String   @default("")
  content     String   // Full markdown/HTML content
  category    String   @default("NEWS") // NEWS | TUTORIAL | BIES_UPDATE | LEGAL | GUIDE
  thumbnail   String   @default("")
  authorName  String   @default("") @map("author_name")
  isPublished Boolean  @default(false) @map("is_published")
  tags        String   @default("[]") // JSON array
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("articles")
}

// ─────────────────────────────────────────────────────────────────────────────
// Content: Videos
// ─────────────────────────────────────────────────────────────────────────────

model Video {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  url         String   // YouTube/embed URL
  thumbnail   String   @default("")
  category    String   @default("GENERAL") // GENERAL | TUTORIAL | INTERVIEW | DEMO
  duration    Int?     // seconds
  isPublished Boolean  @default(false) @map("is_published")
  tags        String   @default("[]") // JSON array
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("videos")
}

// ─────────────────────────────────────────────────────────────────────────────
// Content: Legal Resources
// ─────────────────────────────────────────────────────────────────────────────

model LegalResource {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  category    String   @default("GENERAL") // GENERAL | TERMS | PRIVACY | COMPLIANCE | TEMPLATE
  fileKey     String   @map("file_key") // S3 key or local path
  fileName    String   @default("") @map("file_name")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("legal_resources")
}

// ─────────────────────────────────────────────────────────────────────────────
// Zap Receipts (Lightning zaps via Nostr NIP-57)
// ─────────────────────────────────────────────────────────────────────────────

model ZapReceipt {
  id              String   @id @default(cuid())
  eventId         String   @unique @map("event_id")
  senderPubkey    String   @map("sender_pubkey")
  recipientPubkey String   @map("recipient_pubkey")
  amountMsats     BigInt   @map("amount_msats")
  amountSats      Int      @map("amount_sats")
  comment         String   @default("")
  zappedEventId   String?  @map("zapped_event_id")
  projectId       String?  @map("project_id")
  courseId        String?  @map("course_id")
  bolt11          String   @default("")
  bolt12          String   @default("")
  eventCreatedAt  DateTime? @map("event_created_at") // Nostr event created_at (createdAt is row-insert time)
  createdAt       DateTime @default(now()) @map("created_at")

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  course  Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([recipientPubkey])
  @@index([projectId])
  @@index([courseId])
  @@index([senderPubkey])
  @@map("zap_receipts")
}

// ─────────────────────────────────────────────────────────────────────────────
// Browser Fingerprints (ban evasion detection)
// ─────────────────────────────────────────────────────────────────────────────

model BrowserFingerprint {
  id              String   @id @default(cuid())
  fingerprintHash String   @map("fingerprint_hash")
  userId          String   @map("user_id")
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fingerprintHash])
  @@index([userId])
  @@map("browser_fingerprints")
}

// ─────────────────────────────────────────────────────────────────────────────
// Investor Role Requests
// ─────────────────────────────────────────────────────────────────────────────

model InvestorRequest {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  status    String   @default("PENDING") // PENDING | APPROVED | DENIED
  message   String   @default("") // optional pitch or linkedin link
  reviewedAt DateTime? @map("reviewed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("investor_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
// Gamification (points ledger, scores, badges, leaderboards)
// ─────────────────────────────────────────────────────────────────────────────

model PointEvent {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  nostrEventId  String?  @map("nostr_event_id")
  kind          Int?
  reason        String   // POST | REPLY | REACTION_GIVEN | REACTION_RECEIVED | QUALITY_BONUS | ADMIN_ADJUST | COURSE_COMPLETED
  points        Int      // 0 (audit rows) and negative (admin adjust) allowed
  month         String   // 'YYYY-MM' (UTC, from event timestamp)
  targetEventId String?  @map("target_event_id")
  meta          String   @default("{}") // JSON: rateLimited, dailyCapped, aiScore, ...
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([nostrEventId, userId, reason])
  @@index([userId, month])
  @@index([userId, targetEventId])
  @@index([userId, reason, createdAt])
  @@map("point_events")
}

model UserScore {
  userId            String    @id @map("user_id")
  monthlyPoints     Int       @default(0) @map("monthly_points")
  lifetimePoints    Int       @default(0) @map("lifetime_points")
  bountyPoints      Int       @default(0) @map("bounty_points") // spendable bounty balance; never feeds levels/leaderboards
  level             Int       @default(0)
  currentMonth      String    @map("current_month") // 'YYYY-MM' the monthlyPoints belong to
  lastScoredNoteAt  DateTime? @map("last_scored_note_at")
  streakDays        Int       @default(0) @map("streak_days")
  lastActiveDay     String?   @map("last_active_day") // 'YYYY-MM-DD' UTC
  postCount         Int       @default(0) @map("post_count")
  replyCount        Int       @default(0) @map("reply_count")
  reactionsGiven    Int       @default(0) @map("reactions_given")
  reactionsReceived Int       @default(0) @map("reactions_received")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([monthlyPoints])
  @@index([lifetimePoints])
  @@map("user_scores")
}

model UserBadge {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  badgeId           String   @map("badge_id")
  month             String   @default("") // '' = permanent; 'YYYY-MM' for monthly badges
  nostrAwardEventId String?  @map("nostr_award_event_id") // NIP-58 kind-8 award event id
  awardedAt         DateTime @default(now()) @map("awarded_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId, month])
  @@index([userId])
  @@map("user_badges")
}

model LeaderboardSnapshot {
  id        String   @id @default(cuid())
  month     String   // 'YYYY-MM'
  userId    String   @map("user_id")
  rank      Int
  points    Int
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([month, userId])
  @@index([month, rank])
  @@map("leaderboard_snapshots")
}

// ─────────────────────────────────────────────────────────────────────────────
// Directories (Farm & Certified Provider listings)
// ─────────────────────────────────────────────────────────────────────────────

model DirectoryListing {
  id        String @id @default(cuid())
  type      String // FARM | PROVIDER
  name      String
  about     String @default("")
  photo     String @default("")            // hero + card thumbnail
  logo      String @default("")            // circular overlay logo
  photos    String @default("[]")
  location  String @default("")
  phone     String @default("")
  whatsapp  String @default("")
  email     String @default("")
  website   String @default("")
  instagram String @default("")
  languages String @default("[]")
  btcAccepted Boolean @default(false) @map("btc_accepted")
  products  String @default("[]")          // FARM: [{label, icon}] chips
  practices String @default("[]")          // FARM: regenerative|rotational-grazing|no-gmo-feed|animal-welfare
  skills    String @default("[]")          // PROVIDER
  bestFor   String @default("") @map("best_for")
  pricing   String @default("")            // free text (decision)
  comment   String @default("")
  baseScore       Int      @default(40) @map("base_score")        // admin-set 0–60
  reputationScore Int      @default(0)  @map("reputation_score")  // computed 0–100
  isCertified     Boolean  @default(false) @map("is_certified")
  certifiedAt     DateTime? @map("certified_at")
  certificationEventId String? @map("certification_event_id")     // Phase 2
  status      String  @default("pending-review") // draft|pending-review|active|rejected
  isPublished Boolean @default(true) @map("is_published")
  isFeatured  Boolean @default(false) @map("is_featured")
  viewCount   Int     @default(0) @map("view_count")
  nostrListingEventId String? @map("nostr_listing_event_id")
  ownerId      String  @map("owner_id")
  memberUserId String? @map("member_user_id")  // optional link to the pro/farm's BIES account
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  owner        User @relation("DirectoryListingsOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  memberUser   User? @relation("DirectoryListingsAsMember", fields: [memberUserId], references: [id], onDelete: SetNull)
  endorsements DirectoryEndorsement[]
  @@index([type, status])
  @@map("directory_listings")
}

model DirectoryEndorsement {
  id        String   @id @default(cuid())
  listingId String   @map("listing_id")
  userId    String   @map("user_id")
  comment   String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  listing DirectoryListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([listingId, userId])
  @@map("directory_endorsements")
}

// ─────────────────────────────────────────────────────────────────────────────
// Courses / LMS
// ─────────────────────────────────────────────────────────────────────────────

model Course {
  id              String   @id @default(cuid())
  authorId        String   @map("author_id")
  title           String
  summary         String   @default("")              // short description — the only body text mirrored in paid Nostr events
  description     String   @default("")              // full markdown
  category        String   @default("OTHER")         // BITCOIN | LIGHTNING | NOSTR | FINTECH | BUSINESS | TECHNOLOGY | OTHER
  level           String   @default("BEGINNER")      // BEGINNER | INTERMEDIATE | ADVANCED
  format          String   @default("SELF_PACED")    // SELF_PACED | VIDEO | LIVE | TEXT | WORKSHOP
  coverImage      String   @default("") @map("cover_image")
  tags            String   @default("[]")            // JSON array
  priceSats       Int      @default(0) @map("price_sats") // 0 = free course
  status          String   @default("draft")         // draft | pending-review | active | rejected
  reviewNote      String   @default("") @map("review_note")
  isPublished     Boolean  @default(true) @map("is_published")
  isFeatured      Boolean  @default(false) @map("is_featured")
  viewCount       Int      @default(0) @map("view_count")
  nostrEventId    String?  @map("nostr_event_id")    // NIP-51 kind 30004 curation set (d = course id)
  nostrPublish    String   @default("bies") @map("nostr_publish") // none | bies | public | both
  badgeDefEventId String?  @map("badge_def_event_id") // NIP-58 kind 30009 completion-badge definition
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  author      User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  enrollments Enrollment[]
  purchases   CoursePurchase[]
  zapReceipts ZapReceipt[]

  @@index([status, isPublished])
  @@index([authorId])
  @@map("courses")
}

model Lesson {
  id            String   @id @default(cuid())
  courseId      String   @map("course_id")
  title         String
  type          String   @default("TEXT")   // VIDEO | TEXT | QUIZ
  position      Int      @default(0)
  content       String   @default("{}")     // JSON by type — VIDEO {videoUrl}; TEXT {markdown}; QUIZ {passPct, questions:[{id,prompt,options[]}]} (no answers)
  quizAnswerKey String?  @map("quiz_answer_key") // JSON {questionId: correctIndex} — server-only, never in client projections
  durationSec   Int?     @map("duration_sec")
  isFreePreview Boolean  @default(false) @map("is_free_preview")
  nostrEventId  String?  @map("nostr_event_id") // kind 30023 (free) or 30402 (paid teaser)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress     LessonProgress[]
  quizAttempts QuizAttempt[]

  @@index([courseId, position])
  @@map("lessons")
}

model Enrollment {
  id                 String    @id @default(cuid())
  courseId           String    @map("course_id")
  userId             String    @map("user_id")
  completedAt        DateTime? @map("completed_at")
  certificateEventId String?   @map("certificate_event_id") // NIP-58 kind-8 award event id
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress     LessonProgress[]
  quizAttempts QuizAttempt[]

  @@unique([courseId, userId])
  @@index([userId])
  @@map("enrollments")
}

model LessonProgress {
  id           String   @id @default(cuid())
  enrollmentId String   @map("enrollment_id")
  lessonId     String   @map("lesson_id")
  completedAt  DateTime @default(now()) @map("completed_at")
  meta         String   @default("{}") // JSON: secondsWatched, quizAttemptId, ...

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@map("lesson_progress")
}

model QuizAttempt {
  id           String   @id @default(cuid())
  enrollmentId String   @map("enrollment_id")
  lessonId     String   @map("lesson_id")
  answers      String   @default("{}") // JSON {questionId: selectedIndex}
  scorePct     Int      @map("score_pct")
  passed       Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([enrollmentId, lessonId])
  @@map("quiz_attempts")
}

model CoursePurchase {
  id            String   @id @default(cuid())
  courseId      String   @map("course_id")
  userId        String   @map("user_id")
  amountSats    Int      @map("amount_sats")
  method        String   // ZAP | COINOS | ADMIN_GRANT
  zapReceiptIds String   @default("[]") @map("zap_receipt_ids") // JSON array of consumed ZapReceipt.eventId (audit)
  paymentHash   String   @default("") @map("payment_hash")
  createdAt     DateTime @default(now()) @map("created_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([userId])
  @@map("course_purchases")
}

// ─────────────────────────────────────────────────────────────────────────────
// Relay Access Vouchers (admin-issued links that whitelist external pubkeys)
// ─────────────────────────────────────────────────────────────────────────────

model Voucher {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String    @default("RELAY_ACCESS") // RELAY_ACCESS | ONBOARDING
  status      String    @default("ACTIVE") // ACTIVE | REVOKED
  label       String    @default("")
  priceSats   Int       @default(0) @map("price_sats")
  maxUses     Int       @default(1) @map("max_uses") // 0 = unlimited
  useCount    Int       @default(0) @map("use_count") // COMPLETED redemptions
  expiresAt   DateTime? @map("expires_at")
  notes       String    @default("")
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  createdBy   User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  redemptions VoucherRedemption[]

  @@index([type])
  @@index([status])
  @@map("vouchers")
}

model VoucherRedemption {
  id          String    @id @default(cuid())
  voucherId   String    @map("voucher_id")
  pubkey      String?   // hex pubkey (RELAY_ACCESS); null for ONBOARDING signups
  userId      String?   @map("user_id") // signed-up user (ONBOARDING attribution)
  status      String    @default("COMPLETED") // PENDING_PAYMENT | COMPLETED | EXPIRED | REVOKED
  invoiceHash String?   @map("invoice_hash")
  bolt11      String    @default("")
  amountSats  Int       @default(0) @map("amount_sats")
  ipAddress   String?   @map("ip_address")
  redeemedAt  DateTime? @map("redeemed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([voucherId, pubkey])
  @@index([voucherId])
  @@index([pubkey])
  @@index([status])
  @@map("voucher_redemptions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Marketplace (Shopstr / NIP-99 kind:30402 moderation)
// ─────────────────────────────────────────────────────────────────────────────

model MarketplaceBlock {
  id        String   @id @default(cuid())
  type      String   // pubkey | address ("30402:<pubkey>:<dTag>")
  value     String
  reason    String   @default("")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([type, value])
  @@map("marketplace_blocks")
}

// ─────────────────────────────────────────────────────────────────────────────
// Bounties (Stacker News model: sats pay-on-award, points escrow-at-post)
// ─────────────────────────────────────────────────────────────────────────────

model Bounty {
  id                 String    @id @default(cuid())
  posterId           String    @map("poster_id")
  title              String
  description        String    @default("") // markdown
  rewardType         String    @map("reward_type") // SATS | POINTS
  amount             Int       // immutable after create (escrow integrity)
  status             String    @default("OPEN") // OPEN | AWARDED | PAID | EXPIRED | CANCELLED
  winnerSubmissionId String?   @unique @map("winner_submission_id")
  nostrEventId       String?   @map("nostr_event_id") // kind-1 feed mirror note
  deadline           DateTime?
  featured           Boolean   @default(false)
  awardedAt          DateTime? @map("awarded_at")
  paidAt             DateTime? @map("paid_at")
  paidVia            String?   @map("paid_via") // POINTS | WALLET | ZAP_RECEIPT | MANUAL
  zapReceiptId       String?   @map("zap_receipt_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  poster           User               @relation("BountiesPosted", fields: [posterId], references: [id], onDelete: Cascade)
  submissions      BountySubmission[] @relation("BountySubmissions")
  winnerSubmission BountySubmission?  @relation("BountyWinner", fields: [winnerSubmissionId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([posterId])
  @@map("bounties")
}

model BountySubmission {
  id        String   @id @default(cuid())
  bountyId  String   @map("bounty_id")
  userId    String   @map("user_id")
  content   String   // markdown; editable while bounty is OPEN
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bounty    Bounty  @relation("BountySubmissions", fields: [bountyId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  wonBounty Bounty? @relation("BountyWinner")

  @@unique([bountyId, userId])
  @@index([userId])
  @@map("bounty_submissions")
}
