<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and later: nothing of BIES's goes into a cloud backup or a
    transfer to a new phone. The WebView's storage holds the session tokens,
    and a key held on the device (src/services/session.js). allowBackup="false"
    stops cloud backups only.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
